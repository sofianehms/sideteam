{
  "name": "sideteam",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "bench": "esbuild bench/run.ts --bundle --packages=external --platform=node --target=node20 --format=esm --outfile=bench/.out/run.js && node bench/.out/run.js",
    "bench:validate": "esbuild bench/validate-tasks.ts --bundle --packages=external --platform=node --format=esm --outfile=bench/.out/validate-tasks.js && node bench/.out/validate-tasks.js",
    "build": "node scripts/build.mjs",
    "check:dist": "node scripts/check-dist.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "biome ci .",
    "format": "biome format --write .",
    "test": "vitest run --coverage"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "2.4.0",
    "zod": "4.3.6"
  },
  "devDependencies": {
    "@biomejs/biome": "2.3.14",
    "@modelcontextprotocol/client": "2.4.0",
    "@types/node": "20.19.40",
    "@vitest/coverage-v8": "4.1.9",
    "esbuild": "0.28.2",
    "typescript": "5.9.3",
    "vitest": "4.1.9"
  }
}
